PORT=1010
SECRET_KEY=change-this-in-production
# Comma-separated list, e.g. https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=*
# Contact email used in Nominatim User-Agent per usage policy
# Strongly recommended for better reliability with Nominatim
NOMINATIM_EMAIL=you@example.com

# Optional: Force a specific Overpass endpoint
# Accepts either base or full form:
#   https://overpass.kumi.systems/api
#   https://overpass.kumi.systems/api/interpreter
# OVERPASS_URL=

# Optional: Comma-separated list of Overpass endpoints to try (left-to-right)
# Accepts base or full; examples:
#   https://overpass.kumi.systems/api,https://overpass-api.de/api
#   https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# OVERPASS_ENDPOINTS=

# Completed analysis cache: shared by local workers via SQLite.
ANALYSIS_CACHE_TTL_SECONDS=3600
ANALYSIS_CACHE_MAX_ENTRIES=512
# ANALYSIS_CACHE_PATH=cache/analyses.sqlite3
# Set Redis for a cache shared across serverless instances or multiple hosts.
# REDIS_URL=rediss://default:password@host:6379/0
# Report snapshots expire after one day. SECRET_KEY must match across workers.
REPORT_TOKEN_TTL_SECONDS=86400
